<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="DroneDelivery.LoginPage"
             Title="Logowanie"
             BackgroundColor="#F5F5F7">

    <ScrollView>
        <VerticalStackLayout VerticalOptions="Center" Spacing="20" Padding="30">
            
            <Label Text="Drone Delivery" FontSize="32" FontAttributes="Bold" TextColor="#333" HorizontalOptions="Center" Margin="0,0,0,20"/>

            <Frame BackgroundColor="White" CornerRadius="15" Padding="25" HasShadow="True" BorderColor="Transparent">
                <VerticalStackLayout Spacing="15">
                    <Label Text="Zaloguj się" FontSize="20" TextColor="#6200EE" FontAttributes="Bold" HorizontalOptions="Center"/>

                    <Entry x:Name="LoginEntry" Placeholder="Login" PlaceholderColor="Gray" TextColor="Black" BackgroundColor="#F0F0F0" HeightRequest="50"/>
                    <Entry x:Name="PasswordEntry" Placeholder="Hasło" IsPassword="True" PlaceholderColor="Gray" TextColor="Black" BackgroundColor="#F0F0F0" HeightRequest="50"/>

                    <Button Text="ZALOGUJ SIĘ" Clicked="OnLoginClicked" BackgroundColor="#6200EE" TextColor="White" FontAttributes="Bold" CornerRadius="8" HeightRequest="50" Margin="0,10,0,0"/>
                </VerticalStackLayout>
            </Frame>

            <VerticalStackLayout Spacing="5" Margin="0,20,0,0">
                <Label Text="Nie masz konta?" TextColor="Gray" HorizontalOptions="Center"/>
                <Button Text="Utwórz nowe konto" Clicked="OnRegisterClicked" BackgroundColor="Transparent" TextColor="#6200EE" FontAttributes="Bold"/>
            </VerticalStackLayout>

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>