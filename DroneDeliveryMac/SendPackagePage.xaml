<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:sys="clr-namespace:System;assembly=mscorlib"
             x:Class="DroneDelivery.SendPackagePage"
             Title="Formularz Nadania">

    <ScrollView>
        <VerticalStackLayout Spacing="20" Padding="30" MaximumWidthRequest="600" HorizontalOptions="Center">
            
            <Frame BorderColor="#CCC" CornerRadius="10" Padding="20">
                <VerticalStackLayout Spacing="15">
                    <Entry x:Name="OriginEntry" Placeholder="Adres Nadania" Text="Warszawa, Złote Tarasy"/>
                    <Entry x:Name="DestEntry" Placeholder="Adres Dostawy" Text="Warszawa, Rynek Starego Miasta"/>
                </VerticalStackLayout>
            </Frame>

            <Grid ColumnDefinitions="*,*">
                <DatePicker x:Name="SendDate" DateSelected="OnDateChanged" Date="{x:Static sys:DateTime.Now}" Format="dd/MM/yyyy" Grid.Column="0"/>
                <DatePicker x:Name="DeliveryDate" DateSelected="OnDateChanged" Date="{x:Static sys:DateTime.Now}" Format="dd/MM/yyyy" Grid.Column="1"/>
            </Grid>

            <Label Text="Waga Paczki" TextColor="Gray"/>
            <Slider x:Name="WeightSlider" Minimum="0" Maximum="5" Value="1.0" ValueChanged="OnSliderValueChanged" ThumbColor="#6200EE"/>
            <Label x:Name="WeightLabel" Text="1.0 kg" HorizontalOptions="End"/>

            <Frame BackgroundColor="#EEEEEE" Padding="20">
                <Label x:Name="CostLabel" Text="Koszt: -- PLN" 
                       FontSize="20" HorizontalOptions="Center" FontAttributes="Bold"/>
            </Frame>

            <Button Text="ZAPŁAĆ I WYŚLIJ" 
                    Clicked="OnPayAndSendClicked"
                    BackgroundColor="#4A148C" 
                    TextColor="White"
                    HeightRequest="50"
                    CornerRadius="8"/>
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>