<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="DroneDelivery.AdminPage"
             Title="Panel Administratora"
             BackgroundColor="#F5F5F7">

    <ContentPage.ToolbarItems>
        <ToolbarItem Text="Wyloguj" Clicked="OnLogoutClicked" Order="Primary"/>
    </ContentPage.ToolbarItems>

    <Grid RowDefinitions="Auto, *">
        
        <Grid Grid.Row="0" ColumnDefinitions="*,*" Padding="10" BackgroundColor="White">
            <Button x:Name="TabOrdersBtn" Text="📦 PACZKI" Clicked="OnTabChanged" 
                    BackgroundColor="#6200EE" TextColor="White" CornerRadius="0" Margin="0,0,2,0"/>
            <Button x:Name="TabUsersBtn" Text="👤 UŻYTKOWNICY" Clicked="OnTabChanged" 
                    BackgroundColor="LightGray" TextColor="Black" CornerRadius="0" Grid.Column="1"/>
        </Grid>

        <RefreshView Grid.Row="1" x:Name="OrdersView" IsVisible="True" Refreshing="OnRefreshOrders">
            <CollectionView x:Name="OrdersList" Margin="10">
                <CollectionView.ItemTemplate>
                    <DataTemplate>
                        <Frame Margin="0,8" Padding="15" BackgroundColor="White" CornerRadius="12" HasShadow="True" BorderColor="Transparent" VerticalOptions="Start">
                            
                            <VerticalStackLayout Spacing="8">
                                
                                <Label Text="{Binding ClientId, StringFormat='Klient: {0}'}" 
                                       FontAttributes="Bold" 
                                       FontSize="16"
                                       TextColor="#333"/>

                                <Grid ColumnDefinitions="*, Auto, *" ColumnSpacing="5">
                                    <Label Grid.Column="0" Text="{Binding OriginAddress}" TextColor="Gray" FontSize="12" LineBreakMode="TailTruncation"/>
                                    <Label Grid.Column="1" Text="➜" TextColor="#6200EE" FontAttributes="Bold"/>
                                    <Label Grid.Column="2" Text="{Binding DestinationAddress}" TextColor="Gray" FontSize="12" LineBreakMode="TailTruncation"/>
                                </Grid>
                                
                                <Label Text="{Binding Status}" 
                                       TextColor="Purple" 
                                       FontAttributes="Bold" 
                                       FontSize="14"/>
                                
                                <HorizontalStackLayout Spacing="15" 
                                                       Margin="0,10,0,0"
                                                       IsVisible="False">
                                    
                                    <Button Text="ZATWIERDŹ" 
                                            Clicked="OnApproveClicked" 
                                            CommandParameter="{Binding Id}"
                                            BackgroundColor="#4CAF50" 
                                            TextColor="White"
                                            FontAttributes="Bold"
                                            CornerRadius="8"
                                            HeightRequest="40"
                                            Padding="15,0"/>
                                    
                                    <Button Text="ODRZUĆ" 
                                            Clicked="OnRejectClicked" 
                                            CommandParameter="{Binding Id}"
                                            BackgroundColor="#E53935" 
                                            TextColor="White"
                                            FontAttributes="Bold"
                                            CornerRadius="8"
                                            HeightRequest="40"
                                            Padding="15,0"/>

                                    <HorizontalStackLayout.Triggers>
                                        <DataTrigger TargetType="HorizontalStackLayout" Binding="{Binding Status}" Value="Oczekuje na zatwierdzenie">
                                            <Setter Property="IsVisible" Value="True"/>
                                        </DataTrigger>
                                    </HorizontalStackLayout.Triggers>

                                </HorizontalStackLayout>
                            </VerticalStackLayout>
                        </Frame>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>
        </RefreshView>

        <ScrollView Grid.Row="1" x:Name="UsersView" IsVisible="False" Padding="10">
            <VerticalStackLayout Spacing="15">
                
                <Frame BackgroundColor="White" Padding="15" CornerRadius="10" HasShadow="True">
                    <Grid ColumnDefinitions="*, Auto" ColumnSpacing="10">
                        <Entry x:Name="NewUserEntry" 
                               Grid.Column="0"
                               Placeholder="Nazwa nowego użytkownika" 
                               PlaceholderColor="Gray"
                               TextColor="Black" 
                               BackgroundColor="Transparent"/>
                        
                        <Button Grid.Column="1" 
                                Text="DODAJ" 
                                Clicked="OnAddUserClicked" 
                                BackgroundColor="#6200EE" 
                                TextColor="White" 
                                FontAttributes="Bold"
                                CornerRadius="8"/>
                    </Grid>
                </Frame>

                <Label Text="Lista Użytkowników:" FontAttributes="Bold" Margin="5,10,0,5" TextColor="#333" FontSize="16"/>

                <CollectionView x:Name="UsersList">
                    <CollectionView.ItemTemplate>
                        <DataTemplate>
                            <Frame Margin="0,5" Padding="15" BackgroundColor="White" CornerRadius="10" BorderColor="Transparent">
                                <Grid ColumnDefinitions="*, Auto">
                                    <VerticalStackLayout VerticalOptions="Center">
                                        <Label Text="{Binding Username}" FontAttributes="Bold" TextColor="Black" FontSize="16"/>
                                        <Label Text="{Binding Role}" TextColor="Gray" FontSize="12"/>
                                    </VerticalStackLayout>
                                    
                                    <Button Grid.Column="1" 
                                            Text="USUŃ" 
                                            Clicked="OnDeleteUserClicked" 
                                            CommandParameter="{Binding Username}"
                                            BackgroundColor="#FFEBEE" 
                                            TextColor="#D32F2F"
                                            FontAttributes="Bold"
                                            CornerRadius="8"
                                            HeightRequest="40" 
                                            FontSize="12"/>
                                </Grid>
                            </Frame>
                        </DataTemplate>
                    </CollectionView.ItemTemplate>
                </CollectionView>
            </VerticalStackLayout>
        </ScrollView>

    </Grid>
</ContentPage>