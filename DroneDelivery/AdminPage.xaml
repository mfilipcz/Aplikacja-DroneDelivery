<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="DroneDelivery.AdminPage"
             Title="Panel Administratora"
             BackgroundColor="#f0f0f5">

    <ContentPage.ToolbarItems>
        <ToolbarItem Text="Wyloguj" Clicked="OnLogoutClicked"/>
    </ContentPage.ToolbarItems>

    <Grid RowDefinitions="Auto,*">
        <Button Grid.Row="0" Text="Odśwież listę" Clicked="OnRefreshClicked" Margin="10" BackgroundColor="#6200EE" TextColor="White"/>
        
        <CollectionView Grid.Row="1" x:Name="OrdersList" Margin="10">
            <CollectionView.ItemTemplate>
                <DataTemplate>
                    <Frame Margin="0,5" Padding="10" BackgroundColor="White" BorderColor="LightGray" CornerRadius="8">
                        <StackLayout>
                            <Label Text="{Binding ClientId, StringFormat='Klient: {0}'}" FontAttributes="Bold" TextColor="Black"/>
                            
                            <Grid ColumnDefinitions="*,*">
                                <Label Grid.Column="0" Text="{Binding OriginAddress, StringFormat='Z: {0}'}" TextColor="Gray" FontSize="12"/>
                                <Label Grid.Column="1" Text="{Binding DestinationAddress, StringFormat='Do: {0}'}" TextColor="Gray" FontSize="12"/>
                            </Grid>
                            
                            <Label Text="{Binding Status}" TextColor="Purple" FontAttributes="Bold" Margin="0,5,0,0"/>
                            
                            <HorizontalStackLayout x:Name="ActionButtons" Spacing="10" Margin="0,10,0,0" IsVisible="False">
                                <Button Text="ZATWIERDŹ" 
                                        Clicked="OnApproveClicked" 
                                        CommandParameter="{Binding Id}"
                                        BackgroundColor="Green" 
                                        TextColor="White"
                                        HeightRequest="35" FontSize="12"/>
                                
                                <Button Text="ODRZUĆ" 
                                        Clicked="OnRejectClicked" 
                                        CommandParameter="{Binding Id}"
                                        BackgroundColor="Red" 
                                        TextColor="White"
                                        HeightRequest="35" FontSize="12"/>
                                
                                <HorizontalStackLayout.Triggers>
                                    <DataTrigger TargetType="HorizontalStackLayout" Binding="{Binding Status}" Value="Oczekuje na zatwierdzenie">
                                        <Setter Property="IsVisible" Value="True" />
                                    </DataTrigger>
                                </HorizontalStackLayout.Triggers>
                            </HorizontalStackLayout>
                            
                        </StackLayout>
                    </Frame>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>
    </Grid>
</ContentPage>